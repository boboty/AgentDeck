data: {"id":32,"ticket_id":"tkt_e9048d2b-7f0c-400e-be26-2fdefd1c339d","at":"2026-10-21T19:11:57.760Z","type":"verifier.programmatic","role":"verifier","data":{"checks":[{"name":"snapshot-binding","verdict":"PASS","evidence":"36ea969b1ed7ed1f41763b2c4252579d48779eeb40c57f931685bd920eeaaca7"},{"name":"tool-output-source-equivalence","verdict":"PASS","evidence":"3/3 exact source-query results"},{"name":"source-citations","verdict":"PASS","evidence":"OD-24081,CS-19031,CS-19048,CS-04,RET-01,RET-09,CS-07"},{"name":"deterministic-rules-and-history-unknown","verdict":"PASS","evidence":"{\"daysSinceDelivery\":2,\"ticketDate\":\"2026-10-21\",\"returnEligible\":true,\"historyQueried\":true,\"matchingHistoryCases\":[\"CS-19031\",\"CS-19048\"]}"},{"name":"rule-evidence","verdict":"PASS","evidence":"RET-01,CS-04,CS-07,RET-09"},{"name":"conflict-boundary","verdict":"PASS","evidence":"disposition=follow_up; conflictSources=false"},{"name":"no-unauthorized-promise","verdict":"PASS","evidence":"No simulated recommendation may claim an executed financial action."}]}}

