# Copy this file to .env, add your own DeepSeek API key, and restart AgentDeck.
# The .env file is read by the native Node server and passed to the Compose app.
AGENTDECK_MODEL_PROVIDER=deepseek
AGENTDECK_MODEL_BASE_URL=https://api.deepseek.com
AGENTDECK_MODEL=deepseek-flash
AGENTDECK_MODEL_EFFORT=high
DEEPSEEK_API_KEY=

# Optional role overrides. Empty values inherit the global provider/model/effort.
# AGENTDECK_ORCHESTRATOR_MODEL=
# AGENTDECK_ORCHESTRATOR_EFFORT=
# AGENTDECK_WORKER_MODEL=
# AGENTDECK_WORKER_EFFORT=
# AGENTDECK_VERIFIER_MODEL=
# AGENTDECK_VERIFIER_EFFORT=

# To keep the normal local Codex provider instead, set AGENTDECK_MODEL_PROVIDER=codex,
# remove the DeepSeek key, and remove the DeepSeek model/base URL/effort values above.
